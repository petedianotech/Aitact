rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }
    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    function isValidAudit() {
      return hasRequiredFields(['uid', 'originalText', 'goal', 'createdAt']) &&
             request.resource.data.uid is string &&
             request.resource.data.originalText is string && request.resource.data.originalText.size() <= 10000 &&
             request.resource.data.goal in ["Professional", "Romantic", "Argument", "Negotiation"] &&
             request.resource.data.createdAt is string;
    }
    function isValidUser() {
      return hasRequiredFields(['uid', 'credits']) &&
             request.resource.data.uid is string &&
             request.resource.data.credits is number && request.resource.data.credits >= 0;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser() && uidUnchanged();
      allow update: if isOwner(userId) && isValidUser() && uidNotModified();
    }

    match /audits/{auditId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidAudit() && uidUnchanged();
      allow update: if isDocOwner() && isValidAudit() && uidNotModified();
    }
  }
}
